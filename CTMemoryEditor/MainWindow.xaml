<Window x:Class="CTMemoryEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CTMemoryEditor.ViewModels"
        xmlns:conv="clr-namespace:CTMemoryEditor.Converters"
        mc:Ignorable="d"
        Title="Chrono Trigger - Live Memory Editor"
        Height="720" Width="920" MinHeight="500" MinWidth="750"
        Background="#FF1E1E2E"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColor"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFA6ADC8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="StatBox" TargetType="TextBox">
            <Setter Property="Width" Value="65"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="#FF313244"/>
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="BorderBrush" Value="#FF585B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style x:Key="ReadOnlyBox" TargetType="TextBox" BasedOn="{StaticResource StatBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#FF1E1E2E"/>
            <Setter Property="Foreground" Value="#FF7F849C"/>
            <Setter Property="BorderBrush" Value="#FF45475A"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF38BA8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF45475A"/>
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="BorderBrush" Value="#FF585B70"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CharListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4" Margin="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF585B70"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox dark theme: full ControlTemplate so the popup/items use dark colors -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF313244"/>
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="BorderBrush" Value="#FF585B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#FFCDD6F4"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF45475A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF585B70"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Closed-state display box -->
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="#FFA6ADC8" StrokeThickness="1.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <!-- Transparent overlay that toggles the dropdown on click -->
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Dropdown popup with dark background -->
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#FF313244"
                                        BorderBrush="#FF585B70"
                                        BorderThickness="1"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#FF89B4FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab styling: full ControlTemplate so Background/Foreground are actually applied -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#FF181825"/>
            <Setter Property="Foreground" Value="#FFA6ADC8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#FF45475A"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,0"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF313244"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF585B70"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#FFCDD6F4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="0">
        <Border DockPanel.Dock="Top" Background="#FF181825" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Margin="0,0,6,0"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,0,12,0"/>
                    <Button Content="Take Snapshot"
                            Command="{Binding TakeSnapshotCommand}"
                            Background="#FF89B4FA" Foreground="#FF1E1E2E"
                            BorderBrush="#FF74A9F5" Margin="0,0,6,0"
                            ToolTip="Capture current game state to an in-memory snapshot"/>
                    <Button Content="Apply Snapshot"
                            Command="{Binding ApplySnapshotCommand}"
                            Background="#FFA6E3A1" Foreground="#FF1E1E2E"
                            BorderBrush="#FF8DC98A" Margin="0,0,12,0"
                            ToolTip="{Binding SnapshotLabel}"/>
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToColor}}"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center"
                              Foreground="#FFA6ADC8" FontSize="12" Content="Auto-refresh"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#FF181825" Padding="10,8">
            <WrapPanel>
                <TextBlock Text="Battle Speed:" Style="{StaticResource LabelText}" Margin="0,0,6,0"
                           ToolTip="1=fastest, 8=slowest"/>
                <ComboBox Style="{StaticResource DarkCombo}" Width="42" Margin="0,0,20,0"
                          ItemsSource="{Binding BattleSpeedOptions}"
                          SelectedItem="{Binding BattleSpeed}"
                          ToolTip="1=fastest, 8=slowest"/>

                <TextBlock Text="Gold:" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                <TextBox Text="{Binding Gold, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource StatBox}" Width="100" Margin="0,0,20,0"/>

                <TextBlock Text="Play Time:" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding PlayTimeDisplay}" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="14" Foreground="#FFCDD6F4" Margin="0,0,20,0"/>

                <TextBlock Text="Storyline:" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                <TextBox Text="{Binding StorylineHex, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource StatBox}" Width="50" Margin="0,0,6,0"/>

                <TextBlock Text="(GS/BD:" Style="{StaticResource LabelText}" Margin="0,0,2,0" Foreground="#FF6C7086"/>
                <TextBox Text="{Binding StorylineGameStateHex, Mode=OneWay}" IsReadOnly="True"
                         Style="{StaticResource StatBox}" Width="30" Margin="0,0,2,0"
                         Foreground="#FFA6E3A1" Background="#FF313244" ToolTip="GameState (Out of Sync Backup)"/>
                <TextBlock Text="|" Style="{StaticResource LabelText}" Margin="0,0,2,0" Foreground="#FF6C7086"/>
                <TextBox Text="{Binding StorylineBattleDataHex, Mode=OneWay}" IsReadOnly="True"
                         Style="{StaticResource StatBox}" Width="30" Margin="0,0,2,0"
                         Foreground="#FF89DCEB" Background="#FF313244" ToolTip="BattleData (True Value)"/>
                <TextBlock Text=")" Style="{StaticResource LabelText}" Margin="0,0,20,0" Foreground="#FF6C7086"/>

                <TextBlock Text="RNG Seed:" Style="{StaticResource LabelText}" Margin="0,0,6,0"
                           Visibility="{Binding RngSeedAvailable, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="MSVC rand() internal LCG state (_ranseed). Next rand() = (seed × 214013 + 2531011) >> 16 &amp; 0x7FFF"/>
                <TextBox Text="{Binding RngSeedHex, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource StatBox}" Width="90" Margin="0,0,20,0"
                         Visibility="{Binding RngSeedAvailable, Converter={StaticResource BoolToVisibility}}"
                         FontFamily="Consolas"
                         ToolTip="MSVC rand() internal LCG state (_ranseed). Next rand() = (seed × 214013 + 2531011) >> 16 &amp; 0x7FFF"/>

                <TextBlock Text="Party:" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>

                <ComboBox Style="{StaticResource DarkCombo}" Margin="0,0,4,0"
                          ItemsSource="{Binding PartyCharacterOptions}"
                          SelectedValue="{Binding PartySlot0}"
                          SelectedValuePath="Id">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Style="{StaticResource DarkCombo}" Margin="0,0,4,0"
                          ItemsSource="{Binding PartyCharacterOptions}"
                          SelectedValue="{Binding PartySlot1}"
                          SelectedValuePath="Id">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Style="{StaticResource DarkCombo}"
                          ItemsSource="{Binding PartyCharacterOptions}"
                          SelectedValue="{Binding PartySlot2}"
                          SelectedValuePath="Id">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </WrapPanel>
        </Border>

        <TabControl Background="#FF1E1E2E" BorderThickness="0" Padding="0">
            <TabItem Header="Characters">
                <Grid Background="#FF1E1E2E">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FF181825" Padding="4">
                        <ListBox ItemsSource="{Binding Characters}"
                                 SelectedItem="{Binding SelectedCharacter}"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource CharListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16,8">
                        <StackPanel DataContext="{Binding SelectedCharacter}">

                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold"
                                       Foreground="#FF89B4FA" Margin="0,0,0,8"/>

                            <TextBlock Text="Level &amp; Experience" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Level:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Column="1" Text="{Binding Level, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="2" Text="Total XP:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Column="3" Text="{Binding TotalXP, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}" Width="90" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="4" Text="XP to Next:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Column="5" Text="{Binding XPToNextLevel}"
                                         Style="{StaticResource ReadOnlyBox}" Width="80"/>
                            </Grid>

                            <TextBlock Text="HP / MP" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="HP Current:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HPCurrent, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="HP Max:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding HPMax, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="HP Base:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding HPBase, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="MP Current:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MPCurrent, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="MP Max:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MPMax, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}"/>
                            </Grid>

                            <TextBlock Text="Base Stats" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Strength:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Strength, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Stamina:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Stamina, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Speed, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Magic:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Magic, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Accuracy:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Accuracy, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Evasion:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Evasion, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Mag. Defense:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MagicDefense, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource StatBox}"/>
                            </Grid>

                            <TextBlock Text="Computed Stats (with equipment)" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Strength:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ComputedStrength, Mode=OneWay}"
                                         Style="{StaticResource ReadOnlyBox}" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Stamina:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ComputedStamina, Mode=OneWay}"
                                         Style="{StaticResource ReadOnlyBox}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ComputedSpeed, Mode=OneWay}"
                                         Style="{StaticResource ReadOnlyBox}" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Magic:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ComputedMagic, Mode=OneWay}"
                                         Style="{StaticResource ReadOnlyBox}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Accuracy:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ComputedAccuracy, Mode=OneWay}"
                                         Style="{StaticResource ReadOnlyBox}" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Evasion:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ComputedEvasion, Mode=OneWay}"
                                         Style="{StaticResource ReadOnlyBox}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Mag. Defense:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ComputedMagicDefense, Mode=OneWay}"
                                         Style="{StaticResource ReadOnlyBox}" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Attack Pwr:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AttackPower, Mode=OneWay}"
                                         Style="{StaticResource ReadOnlyBox}" Margin="0,0,20,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="Defense:" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Defense, Mode=OneWay}"
                                         Style="{StaticResource ReadOnlyBox}"/>
                            </Grid>

                            <TextBlock Text="Equipment" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Weapon:" Style="{StaticResource LabelText}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding WeaponOptions}"
                                          SelectedValue="{Binding Weapon}"
                                          SelectedValuePath="Encoded"
                                          Style="{StaticResource DarkCombo}" Width="200" Margin="0,2">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Armor:" Style="{StaticResource LabelText}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding ArmorOptions}"
                                          SelectedValue="{Binding Armor}"
                                          SelectedValuePath="Encoded"
                                          Style="{StaticResource DarkCombo}" Width="200" Margin="0,2">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Helmet:" Style="{StaticResource LabelText}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          ItemsSource="{Binding HelmetOptions}"
                                          SelectedValue="{Binding Helmet}"
                                          SelectedValuePath="Encoded"
                                          Style="{StaticResource DarkCombo}" Width="200" Margin="0,2">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Accessory:" Style="{StaticResource LabelText}"/>
                                <ComboBox Grid.Row="3" Grid.Column="1"
                                          ItemsSource="{Binding AccessoryOptions}"
                                          SelectedValue="{Binding Accessory}"
                                          SelectedValuePath="Encoded"
                                          Style="{StaticResource DarkCombo}" Width="200" Margin="0,2">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Inventory">
                <DockPanel Background="#FF1E1E2E" Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox IsChecked="{Binding ShowEmptySlots}" VerticalAlignment="Center"
                                  Foreground="#FFA6ADC8" FontSize="12" Content="Show empty slots" Margin="0,0,16,0"/>
                        <TextBlock VerticalAlignment="Center" Foreground="#FF7F849C" FontSize="12">
                            <Run Text="Showing "/><Run Text="{Binding InventorySlots.Count, Mode=OneWay}"/><Run Text=" slots"/>
                        </TextBlock>

                        <Separator Width="1" Background="#FF45475A" Margin="16,0"/>

                        <TextBlock Text="Category:" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CategoryCombo"
                                  Style="{StaticResource DarkCombo}"
                                  ItemsSource="{Binding AvailableCategoryNames}"
                                  SelectedIndex="{Binding PendingCategoryIndex}"
                                  Margin="0,0,8,0" MinWidth="120"/>

                        <TextBlock Text="Item:" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ItemCombo"
                                  Style="{StaticResource DarkCombo}"
                                  ItemsSource="{Binding AvailableItems}"
                                  SelectedItem="{Binding PendingItem}"
                                  Margin="0,0,8,0" MinWidth="160">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="Add Item"
                                Command="{Binding AddItemCommand}"
                                Margin="0,0,6,0"
                                Background="#FF40A02B" Foreground="#FFCDD6F4"
                                BorderBrush="#FF2D7A1D" Padding="12,4"/>

                        <Button Content="Remove Selected"
                                Command="{Binding RemoveItemCommand}"
                                CommandParameter="{Binding ElementName=InventoryGrid, Path=SelectedItem}"
                                Background="#FFF38BA8" Foreground="#FF1E1E2E"
                                BorderBrush="#FFD4758A" Padding="12,4"/>
                    </StackPanel>

                    <DataGrid x:Name="InventoryGrid"
                              ItemsSource="{Binding InventorySlots}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              Background="#FF1E1E2E"
                              RowBackground="#FF1E1E2E"
                              AlternatingRowBackground="#FF181825"
                              Foreground="#FFCDD6F4"
                              BorderBrush="#FF45475A"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#FF313244"
                              HeadersVisibility="Column"
                              FontSize="13"
                              FontFamily="Consolas"
                              ColumnHeaderHeight="28">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF313244"/>
                                <Setter Property="Foreground" Value="#FFA6ADC8"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="BorderBrush" Value="#FF45475A"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slot" Binding="{Binding SlotIndex}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName, Mode=OneWay}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding ItemIndex}" IsReadOnly="True" Width="45"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
